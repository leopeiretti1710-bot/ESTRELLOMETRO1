// SOLO PROTOTIPO: casi todo es abierto. El evento solo se puede borrar cuando ya venció (hora del servidor).
// Antes de uso público, agregá Firebase Auth anónima y limitá moderación/edición al organizador.
rules_version = "2";
service cloud.firestore {
  match /databases/{db}/documents {
    match /events/{code} {
      allow read, create, update: if true;
      allow delete: if resource.data.end < request.time.toMillis();
      match /photos/{id} {
        allow read, update, delete: if true;
        allow create: if request.resource.data.src.size() < 900000;
      }
      match /members/{uid} {
        allow read, create, update, delete: if true;
      }
    }
  }
}
